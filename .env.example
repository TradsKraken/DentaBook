# ========================================================
# DentaBook - Environment Configuration Template
# Copy this file to .env and adjust variables as needed
# ========================================================

# Server Port Configuration
PORT=5000
CLIENT_PORT=3000

# Database Configuration (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USER=dentabook_user
DB_PASSWORD=dentabook_secure_password_replace_in_prod
DB_NAME=dentabook_db

# Security & Authentication
JWT_SECRET=replace_this_with_a_long_random_jwt_secret_key_at_least_32_characters
JWT_EXPIRES_IN=8h

# CORS Configuration
CLIENT_URL=http://localhost:3000
