# ========================================================
# DentaBook - Environment Configuration Template
# Copy this file to .env and adjust variables as needed
# ========================================================

# Server Port Configuration
PORT=5000
CLIENT_PORT=3000

# Database Configuration (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USER=dentabook_user
DB_PASSWORD=dentabook_secure_password_replace_in_prod
DB_NAME=dentabook_db

# Opaque sessions: administrators expire after one hour; other roles after eight.
# List only the IPs/CIDRs of reverse proxies you operate; leave blank for direct access.
TRUST_PROXY=

# Exact browser origin. Use HTTPS for production deployments.
CLIENT_URL=http://localhost:3000

# Keep production for HTTPS hosting. For local LAN HTTP testing only, use
# development and set CLIENT_URL to the exact LAN address and port.
NODE_ENV=production


# Optional separated production portals (Compose 2.24.4+). Keep these commented
# for combined local development. Use separate HTTPS hosts for browser sign-in.
# COMPOSE_FILE=docker-compose.yml:docker-compose.production.yml
# CLIENT_PORT=3003
# ADMIN_PORT=3005
# ADMIN_URL=https://dentabook-admin.forgroup.space
