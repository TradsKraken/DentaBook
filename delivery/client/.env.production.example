# Copy to .env on the production server and supply a unique database password.
COMPOSE_PROJECT_NAME=dentabook
COMPOSE_FILE=docker-compose.yml:docker-compose.production.yml
NODE_ENV=production
CLIENT_PORT=3003
ADMIN_PORT=3005
CLIENT_URL=https://dentabook.forgroup.space
ADMIN_URL=https://dentabook-admin.forgroup.space
DB_HOST=db
DB_PORT=5432
DB_USER=dentabook_user
DB_NAME=dentabook_db
DB_PASSWORD=REPLACE_WITH_A_NEW_RANDOM_PASSWORD
# Only configure trusted proxies after verifying their network addresses.
TRUST_PROXY=
