flowchart TD
    Visit["Open the main website"]:::current --> Browse["Browse clinics, treatments,<br/>and published-price estimates"]:::current
    Browse --> Contact["Contact a clinic directly"]:::current
    Browse --> Private["Open a personal patient page"]:::current
    Private --> Session{"Valid patient session?"}:::decision
    Session -->|No| Account{"Already registered?"}:::decision
    Account -->|No| Register["Register a patient account"]:::current
    Account -->|Yes| Signin["Patient sign-in"]:::current
    Register --> Signin
    Signin --> Session
    Session -->|Yes| Personal["View account details or<br/>existing linked appointments"]:::current
    Session -->|Yes: booking page| Notice["Online booking is unavailable<br/>No request is created"]:::unavailable

    classDef current fill:#eaf5ff,stroke:#176d9b,color:#16394f,stroke-width:1.5px;
    classDef planned fill:#fff5dc,stroke:#a86c12,color:#62460c,stroke-dasharray:6 4;
    classDef unavailable fill:#f1f4f6,stroke:#8397a3,color:#3f5563;
    classDef decision fill:#ffffff,stroke:#176d9b,color:#16394f;
