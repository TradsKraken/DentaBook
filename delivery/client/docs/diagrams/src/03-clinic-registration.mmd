flowchart TD
    Form["Authorized representative<br/>submits clinic registration"]:::current
    Form --> Save["Server validates details and saves<br/>staff account plus pending clinic"]:::current
    Save --> Wait["While pending: sign in to read status<br/>Approved workspace stays restricted"]:::current
    Save --> Review["Administrator reviews the submission"]:::current
    Review --> Outcome{"Saved decision"}:::decision
    Outcome -->|Approved| Approved["Clinic may appear publicly"]:::current
    Outcome -->|Rejected| Rejected["Clinic stays unpublished<br/>Review reason is saved"]:::current
    Approved --> Workspace["After clinic sign-in:<br/>open own approved workspace"]:::current
    Rejected --> Notes["After clinic sign-in:<br/>read notes and contact the operator"]:::current
    classDef current fill:#eaf5ff,stroke:#176d9b,color:#16394f,stroke-width:1.5px;
    classDef planned fill:#fff5dc,stroke:#a86c12,color:#62460c,stroke-dasharray:6 4;
    classDef unavailable fill:#f1f4f6,stroke:#8397a3,color:#3f5563;
    classDef decision fill:#ffffff,stroke:#176d9b,color:#16394f;
