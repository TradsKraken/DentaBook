flowchart TD
    Open["Open the cost calculator<br/>No sign-in required"]:::current
    Open --> Clinic["Select an approved clinic"]:::current
    Clinic --> Prices{"Published active services available?"}:::decision
    Prices -->|No| Empty["Show the appropriate empty<br/>or unavailable information"]:::unavailable
    Prices -->|Yes| Select["Select the clinic's saved services"]:::current
    Select --> Sum["Add the published selected prices<br/>in the browser"]:::current
    Sum --> Estimate["Display an informational estimate"]:::current
    Estimate --> Contact["Contact the clinic to confirm<br/>care, availability, and final cost"]:::current
    Contact --> Boundary["No reservation, payment,<br/>or appointment record is created"]:::unavailable

    classDef current fill:#eaf5ff,stroke:#176d9b,color:#16394f,stroke-width:1.5px;
    classDef planned fill:#fff5dc,stroke:#a86c12,color:#62460c,stroke-dasharray:6 4;
    classDef unavailable fill:#f1f4f6,stroke:#8397a3,color:#3f5563;
    classDef decision fill:#ffffff,stroke:#176d9b,color:#16394f;
